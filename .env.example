# 复制为 .env 后再填真实值；.env 已被 .gitignore 排除，绝不提交。
# 下面全部是占位符，不是真实密钥。
#
# —— Mock 模式（默认，无需任何密钥即可运行）——
AGENT_MODE=mock
LLM_TIMEOUT_SECONDS=30
#
# —— real 模式（OpenAI 兼容 function calling，已验证目标：智谱 GLM 开放平台）——
# 切换方法：把上面的 AGENT_MODE 改为 real，并取消注释以下三项。
# Base URL 是官方公开文档值（不是密钥）；模型名请以官方模型列表为准（如文档示例中的 glm-5.3）。
# AGENT_MODE=real
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=replace-me
# GENERATION_MODEL=replace-with-model-from-official-docs
